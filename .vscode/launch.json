{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "run ts",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "runtimeExecutable": "/home/carroll/.nvm/versions/node/v22.14.0/bin/npx",
      "runtimeArgs": [
        "tsx"
      ],
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run npm run tunnel",
      "runtimeVersion": "22",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "tunnel"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "npm start",
      "runtimeVersion": "22",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Expo Web",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}",
      // "sourceMapPathOverrides": {
      //   "webpack://?:*/*": "${webRoot}/*",
      //   "webpack:///./~/*": "${webRoot}/node_modules/*"
      // }
    }
  ]
}